<header class="site-header">
  <div class="site-header__inner page-width">
    <button type="button" class="site-header__menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="MobileNav" aria-label="{{ 'accessibility.menu' | t }}">
      {% render 'icon', name: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="150" height="{{ 150 | divided_by: settings.logo.aspect_ratio }}" loading="eager">
      {%- else -%}
        <span class="site-header__logo-mark" aria-hidden="true"></span>
        <span class="site-header__logo-text">{{ settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="site-header__nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
      <ul class="site-header__nav-list">
        {%- for link in section.settings.main_menu.links -%}
          <li class="site-header__nav-item{% if link.links != blank %} has-dropdown{% endif %}">
            <a href="{{ link.url }}" class="site-header__nav-link">
              {{ link.title }}
              {%- if link.links != blank %} {% render 'icon', name: 'chevron-down' %}{% endif -%}
            </a>
            {%- if link.links != blank -%}
              <ul class="site-header__dropdown">
                {%- for childlink in link.links -%}
                  <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <form action="{{ routes.search_url }}" method="get" role="search" class="site-header__search">
        <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.placeholder' | t }}" value="{{ search.terms | escape }}">
        <button type="submit" aria-label="{{ 'general.search.submit' | t }}">{% render 'icon', name: 'search' %}</button>
      </form>

      {%- if settings.dark_mode_enabled %}
        <button type="button" id="ThemeToggle" class="site-header__icon-link site-header__theme-toggle" aria-label="Alternar modo claro/escuro">
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="4"/><line x1="12" y1="20" x2="12" y2="22"/><line x1="4.2" y1="4.2" x2="5.6" y2="5.6"/><line x1="18.4" y1="18.4" x2="19.8" y2="19.8"/><line x1="2" y1="12" x2="4" y2="12"/><line x1="20" y1="12" x2="22" y2="12"/><line x1="4.2" y1="19.8" x2="5.6" y2="18.4"/><line x1="18.4" y1="5.6" x2="19.8" y2="4.2"/></svg>
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      {%- endif %}

      <a href="{{ routes.account_url }}" class="site-header__icon-link" aria-label="{{ 'customer.account.title' | t }}">
        {% render 'icon', name: 'account' %}
      </a>

      <button type="button" class="site-header__icon-link site-header__cart" data-cart-drawer-open aria-label="{{ 'cart.general.title' | t }}">
        {% render 'icon', name: 'cart' %}
        <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>

  <nav id="MobileNav" class="site-header__mobile-nav" data-mobile-nav hidden aria-label="{{ 'accessibility.main_navigation' | t }}">
    <ul>
      {%- for link in section.settings.main_menu.links -%}
        <li>
          <a href="{{ link.url }}">{{ link.title }}</a>
          {%- if link.links != blank -%}
            <ul>
              {%- for childlink in link.links -%}
                <li><a href="{{ childlink.url }}">{{ childlink.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu principal",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
