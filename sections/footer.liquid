<footer class="site-footer">
  <div class="page-width site-footer__grid">
    <div class="site-footer__block site-footer__block--brand">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="130" loading="lazy">
      {%- else -%}
        <span class="site-header__logo-mark" aria-hidden="true"></span>
        <span class="site-header__logo-text">{{ settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
      {%- if section.settings.about_text != blank -%}
        <div class="site-footer__about">{{ section.settings.about_text }}</div>
      {%- endif -%}
      <div class="site-footer__pay-badges">
        <span class="pay-badge pay-badge--pix">Pix</span>
        <span class="pay-badge pay-badge--visa">VISA</span>
        <span class="pay-badge pay-badge--mastercard"><span class="pay-badge__circles"><span></span><span></span></span></span>
        <span class="pay-badge pay-badge--elo">elo</span>
        <span class="pay-badge pay-badge--amex">AMEX</span>
        <span class="pay-badge pay-badge--boleto"><span class="pay-badge__bars"></span>Boleto</span>
        <span class="pay-badge pay-badge--cielo">cielo</span>
      </div>
    </div>

    {%- liquid
      assign footer_blocks = section.blocks
    -%}
    {%- if footer_blocks.size > 0 -%}
      {%- for block in footer_blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="site-footer__block" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.heading }}</h3>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <div class="site-footer__block">
        <h3>Institucional</h3>
        <ul>
          <li><a href="/pages/sobre">Sobre a GameHub</a></li>
          <li><a href="/pages/trabalhe-conosco">Trabalhe conosco</a></li>
          <li><a href="/policies/terms-of-service">Termos de uso</a></li>
          <li><a href="/policies/privacy-policy">Privacidade</a></li>
        </ul>
      </div>
      <div class="site-footer__block">
        <h3>Ajuda</h3>
        <ul>
          <li><a href="/pages/central-de-ajuda">Central de ajuda</a></li>
          <li><a href="/policies/refund-policy">Trocas e reembolso</a></li>
          <li><a href="/pages/status-do-pedido">Status do pedido</a></li>
          <li><a href="/pages/fale-conosco">Fale conosco</a></li>
        </ul>
      </div>
    {%- endif -%}

    <div class="site-footer__block">
      <h3>{{ 'footer.newsletter.heading' | t }}</h3>
      {% form 'customer', id: 'FooterNewsletterForm' %}
        {%- if form.posted_successfully? -%}
          <p class="site-footer__newsletter-success">{{ 'footer.newsletter.success' | t }}</p>
        {%- endif -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="site-footer__newsletter-form">
          <input type="email" name="contact[email]" placeholder="{{ 'footer.newsletter.placeholder' | t }}" required>
          <button type="submit">{{ 'footer.newsletter.submit' | t }}</button>
        </div>
      {% endform %}
    </div>
  </div>

  <div class="page-width site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</p>
    <p class="site-footer__payment-note">{{ section.settings.legal_text }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    {
      "type": "richtext",
      "id": "about_text",
      "label": "Texto institucional",
      "default": "<p>Sua loja de jogos digitais com entrega imediata.</p>"
    },
    {
      "type": "text",
      "id": "legal_text",
      "label": "Texto legal / registro",
      "default": "CNPJ 00.000.000/0001-00"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Lista de links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Título",
          "default": "Institucional"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list", "settings": { "heading": "Institucional" } },
      { "type": "link_list", "settings": { "heading": "Ajuda" } }
    ]
  }
}
{% endschema %}
