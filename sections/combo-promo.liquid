<section class="combo-promo page-width">
  <div class="combo-promo__inner" style="background-color: {{ section.settings.background_color }};">
    <div class="combo-promo__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'combo-promo__placeholder' }}
      {%- endif -%}
    </div>
    <div class="combo-promo__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="combo-promo__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="combo-promo__heading">{{ section.settings.heading }}</h2>
      <p class="combo-promo__text">{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_url }}" class="button button--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Combo promocional",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem" },
    { "type": "color", "id": "background_color", "label": "Cor de fundo", "default": "#F1EEFF" },
    { "type": "text", "id": "eyebrow", "label": "Texto de destaque", "default": "Oferta especial" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Combo de 6 jogos" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Monte seu combo e adicione todos os jogos ao carrinho com um clique." },
    { "type": "text", "id": "button_label", "label": "Botão - texto", "default": "Montar combo" },
    { "type": "url", "id": "button_url", "label": "Botão - link" }
  ],
  "presets": [
    { "name": "Combo promocional" }
  ]
}
{% endschema %}
