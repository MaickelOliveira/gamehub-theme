<section class="combo-promo page-width page-width--wide">
  <div class="combo-promo__inner">
    <div class="combo-promo__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
      {%- else -%}
        <div class="combo-promo__grid" aria-hidden="true">
          {%- for i in (1..6) -%}<i></i>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="combo-promo__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="combo-promo__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="combo-promo__heading">{{ section.settings.heading }}</h2>
      <p class="combo-promo__text">{{ section.settings.text }}</p>

      {%- if section.settings.price_now != blank -%}
        <div class="combo-promo__price-row">
          <span class="combo-promo__price-now">{{ section.settings.price_now }}</span>
          {%- if section.settings.price_was != blank -%}
            <s class="combo-promo__price-was">{{ section.settings.price_was }}</s>
          {%- endif -%}
          {%- if section.settings.save_label != blank -%}
            <span class="combo-promo__save">{{ section.settings.save_label }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        {%- if section.settings.button_url != blank -%}
          <a href="{{ section.settings.button_url }}" class="button button--primary">{{ section.settings.button_label }}</a>
        {%- else -%}
          <button type="button" class="button button--primary" data-combo-builder-open>{{ section.settings.button_label }}</button>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Combo promocional",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagem (opcional)" },
    { "type": "text", "id": "eyebrow", "label": "Texto de destaque", "default": "Oferta especial" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Combo de 6 jogos" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Monte seu combo e adicione todos os jogos ao carrinho com um clique." },
    { "type": "header", "content": "Preço (opcional)" },
    { "type": "text", "id": "price_now", "label": "Preço do combo", "default": "R$ 449,90" },
    { "type": "text", "id": "price_was", "label": "Preço sem desconto" },
    { "type": "text", "id": "save_label", "label": "Selo de economia", "default": "Economize 25%" },
    { "type": "header", "content": "Botão" },
    { "type": "text", "id": "button_label", "label": "Botão - texto", "default": "Montar combo" },
    { "type": "url", "id": "button_url", "label": "Botão - link (opcional; se vazio, abre o montador de combo)" }
  ],
  "presets": [
    { "name": "Combo promocional" }
  ]
}
{% endschema %}
