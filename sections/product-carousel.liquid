{%- liquid
  assign collection = collections[section.settings.collection]
-%}

<section class="carousel-section page-width" {{ section.shopify_attributes }}>
  <div class="carousel-section__header">
    {%- if section.settings.heading != blank -%}
      <h2 class="carousel-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if collection != blank -%}
      <a href="{{ collection.url }}" class="carousel-section__view-all">{{ 'general.view_all' | t }}</a>
    {%- endif -%}
  </div>

  {%- if collection != blank and collection.products.size > 0 -%}
    <div class="carousel" data-carousel>
      <button type="button" class="carousel__control carousel__control--prev" data-carousel-prev aria-label="{{ 'accessibility.previous' | t }}">&larr;</button>
      <ul class="carousel__track" data-carousel-track>
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li class="carousel__slide">
            {% render 'product-card', product: product %}
          </li>
        {%- endfor -%}
      </ul>
      <button type="button" class="carousel__control carousel__control--next" data-carousel-next aria-label="{{ 'accessibility.next' | t }}">&rarr;</button>
    </div>
  {%- else -%}
    <p class="carousel-section__empty">{{ 'collections.general.no_matches' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Carrossel de produtos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lançamentos" },
    { "type": "collection", "id": "collection", "label": "Coleção" },
    { "type": "range", "id": "products_to_show", "label": "Produtos exibidos", "min": 4, "max": 16, "step": 1, "default": 8 }
  ],
  "presets": [
    { "name": "Carrossel de produtos" }
  ]
}
{% endschema %}
