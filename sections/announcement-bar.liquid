{% if section.settings.message != blank %}
  <div class="announcement-bar">
    <div class="announcement-bar__track">
      <p>{{ section.settings.message }} &middot;</p>
      <p aria-hidden="true">{{ section.settings.message }} &middot;</p>
      <p aria-hidden="true">{{ section.settings.message }} &middot;</p>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Barra de anúncio",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Mensagem",
      "default": "Frete grátis acima de R$ 150"
    }
  ]
}
{% endschema %}
