{%- liquid
  assign message_html = section.settings.message | replace: 'Frete grátis', '<span class="announcement-bar__highlight">Frete grátis</span>'
-%}
{% if section.settings.message != blank %}
  <div class="announcement-bar">
    <div class="announcement-bar__track">
      <div class="announcement-bar__group">
        {%- for i in (1..8) -%}
          <p{% unless forloop.first %} aria-hidden="true"{% endunless %}>{{ message_html }} &middot;</p>
        {%- endfor -%}
      </div>
      <div class="announcement-bar__group" aria-hidden="true">
        {%- for i in (1..8) -%}
          <p aria-hidden="true">{{ message_html }} &middot;</p>
        {%- endfor -%}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Barra de anúncio",
  "settings": [
    {
      "type": "text",
      "id": "message",
      "label": "Mensagem",
      "default": "Frete grátis acima de R$ 150"
    }
  ]
}
{% endschema %}
