<section class="hero" {% if section.blocks.size > 1 %}data-hero-slider{% endif %}>
  {%- for block in section.blocks -%}
    {%- liquid
      assign has_video = false
      if block.settings.video_id != blank
        assign has_video = true
      endif
    -%}
    <div class="hero__slide{% if forloop.first %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>
      <div class="hero__media">
        {%- if has_video -%}
          <div
            class="hero__yt-wrap"
            data-youtube-hero
            data-video-id="{{ block.settings.video_id }}"
            data-start="{{ block.settings.video_start }}"
            data-end="{{ block.settings.video_end }}"
            {% unless forloop.first %}data-hero-lazy{% endunless %}
          ></div>
        {%- else -%}
          <div class="hero__image" style="--hero-bg-mobile: url('{{ block.settings.image_mobile | default: block.settings.image | image_url: width: 900 }}'); --hero-bg-desktop: url('{{ block.settings.image | image_url: width: 2000 }}');"></div>
        {%- endif -%}
        <div class="hero__scrim"></div>
        <div class="hero__fade"></div>
      </div>

      <div class="page-width hero__inner">
        <div class="hero__content">
          {%- if block.settings.eyebrow != blank -%}
            <span class="hero__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h1 class="hero__heading">{{ block.settings.heading }}</h1>
          {%- endif -%}
          {%- if block.settings.subheading != blank -%}
            <p class="hero__subheading">{{ block.settings.subheading }}</p>
          {%- endif -%}
          <div class="hero__actions">
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_url }}" class="button button--primary">{{ block.settings.button_label }}</a>
            {%- endif -%}
            {%- if block.settings.button_label_2 != blank -%}
              <a href="{{ block.settings.button_url_2 }}" class="button button--secondary">{{ block.settings.button_label_2 }}</a>
            {%- endif -%}
          </div>

          {%- if block.settings.meta_platforms != blank or block.settings.meta_rating != blank or block.settings.meta_delivery != blank -%}
            <div class="hero__meta">
              {%- if block.settings.meta_platforms != blank -%}
                <div><strong>{{ block.settings.meta_platforms }}</strong>Disponível em</div>
              {%- endif -%}
              {%- if block.settings.meta_rating != blank -%}
                <div><strong>{{ block.settings.meta_rating }}</strong>{{ block.settings.meta_reviews }}</div>
              {%- endif -%}
              {%- if block.settings.meta_delivery != blank -%}
                <div><strong>{{ block.settings.meta_delivery }}</strong>Entrega digital</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endfor -%}

  {%- if section.blocks.size > 1 -%}
    <button type="button" class="hero__nav hero__nav--prev" data-hero-prev aria-label="Banner anterior">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button type="button" class="hero__nav hero__nav--next" data-hero-next aria-label="Próximo banner">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="hero__dots" data-hero-dots>
      {%- for block in section.blocks -%}
        <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" data-hero-dot="{{ forloop.index0 }}" aria-label="Ir para o banner {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Banner principal",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "settings": [
        { "type": "header", "content": "Vídeo de fundo (opcional)" },
        { "type": "text", "id": "video_id", "label": "ID do vídeo do YouTube", "info": "Da URL https://www.youtube.com/watch?v=o_yIvRZC0vQ, o ID é o_yIvRZC0vQ. Se preenchido, o vídeo substitui a imagem de fundo." },
        { "type": "number", "id": "video_start", "label": "Início do trecho (segundos)", "default": 0 },
        { "type": "number", "id": "video_end", "label": "Fim do trecho (segundos)", "default": 0, "info": "O trecho fica em loop automático entre início e fim (ou avança pro próximo banner, se houver mais de um)." },
        { "type": "header", "content": "Imagem de fundo (se não usar vídeo)" },
        { "type": "image_picker", "id": "image", "label": "Imagem de fundo (desktop)" },
        { "type": "image_picker", "id": "image_mobile", "label": "Imagem de fundo (mobile)" },
        { "type": "header", "content": "Conteúdo" },
        { "type": "text", "id": "eyebrow", "label": "Texto de destaque", "default": "Novo lançamento" },
        { "type": "text", "id": "heading", "label": "Título", "default": "O próximo capítulo chegou com tudo" },
        { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Jogue no dia do lançamento, com entrega digital imediata." },
        { "type": "text", "id": "button_label", "label": "Botão 1 - texto", "default": "Comprar agora" },
        { "type": "url", "id": "button_url", "label": "Botão 1 - link" },
        { "type": "text", "id": "button_label_2", "label": "Botão 2 - texto", "default": "Ver lançamentos" },
        { "type": "url", "id": "button_url_2", "label": "Botão 2 - link" },
        { "type": "header", "content": "Métricas (opcional)" },
        { "type": "text", "id": "meta_platforms", "label": "Plataformas", "default": "PS5 · Xbox · PC" },
        { "type": "text", "id": "meta_rating", "label": "Nota", "default": "4,8 / 5" },
        { "type": "text", "id": "meta_reviews", "label": "Texto da nota", "default": "2.311 avaliações" },
        { "type": "text", "id": "meta_delivery", "label": "Entrega", "default": "Imediata" }
      ]
    }
  ],
  "presets": [
    { "name": "Banner principal", "blocks": [{ "type": "slide" }] }
  ]
}
{% endschema %}
