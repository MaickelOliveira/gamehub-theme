{%- liquid
  assign has_video = false
  if section.settings.video_id != blank
    assign has_video = true
  endif
-%}

<section class="hero">
  <div class="hero__media">
    {%- if has_video -%}
      <div
        class="hero__yt-wrap"
        data-youtube-hero
        data-video-id="{{ section.settings.video_id }}"
        data-start="{{ section.settings.video_start }}"
        data-end="{{ section.settings.video_end }}"
      ></div>
    {%- else -%}
      <div class="hero__image" style="--hero-bg-mobile: url('{{ section.settings.image_mobile | default: section.settings.image | image_url: width: 900 }}'); --hero-bg-desktop: url('{{ section.settings.image | image_url: width: 2000 }}');"></div>
    {%- endif -%}
    <div class="hero__scrim"></div>
    <div class="hero__fade"></div>
  </div>

  <div class="page-width hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_url }}" class="button button--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_url_2 }}" class="button button--secondary">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.meta_platforms != blank or section.settings.meta_rating != blank or section.settings.meta_delivery != blank -%}
        <div class="hero__meta">
          {%- if section.settings.meta_platforms != blank -%}
            <div><strong>{{ section.settings.meta_platforms }}</strong>Disponível em</div>
          {%- endif -%}
          {%- if section.settings.meta_rating != blank -%}
            <div><strong>{{ section.settings.meta_rating }}</strong>{{ section.settings.meta_reviews }}</div>
          {%- endif -%}
          {%- if section.settings.meta_delivery != blank -%}
            <div><strong>{{ section.settings.meta_delivery }}</strong>Entrega digital</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner principal",
  "settings": [
    { "type": "header", "content": "Vídeo de fundo (opcional)" },
    { "type": "text", "id": "video_id", "label": "ID do vídeo do YouTube", "info": "Da URL https://www.youtube.com/watch?v=o_yIvRZC0vQ, o ID é o_yIvRZC0vQ. Se preenchido, o vídeo substitui a imagem de fundo." },
    { "type": "number", "id": "video_start", "label": "Início do trecho (segundos)", "default": 0 },
    { "type": "number", "id": "video_end", "label": "Fim do trecho (segundos)", "default": 0, "info": "O trecho fica em loop automático entre início e fim." },
    { "type": "header", "content": "Imagem de fundo (se não usar vídeo)" },
    { "type": "image_picker", "id": "image", "label": "Imagem de fundo (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Imagem de fundo (mobile)" },
    { "type": "header", "content": "Conteúdo" },
    { "type": "text", "id": "eyebrow", "label": "Texto de destaque", "default": "Novo lançamento" },
    { "type": "text", "id": "heading", "label": "Título", "default": "O próximo capítulo chegou com tudo" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Jogue no dia do lançamento, com entrega digital imediata." },
    { "type": "text", "id": "button_label", "label": "Botão 1 - texto", "default": "Comprar agora" },
    { "type": "url", "id": "button_url", "label": "Botão 1 - link" },
    { "type": "text", "id": "button_label_2", "label": "Botão 2 - texto", "default": "Ver lançamentos" },
    { "type": "url", "id": "button_url_2", "label": "Botão 2 - link" },
    { "type": "header", "content": "Métricas (opcional)" },
    { "type": "text", "id": "meta_platforms", "label": "Plataformas", "default": "PS5 · Xbox · PC" },
    { "type": "text", "id": "meta_rating", "label": "Nota", "default": "4,8 / 5" },
    { "type": "text", "id": "meta_reviews", "label": "Texto da nota", "default": "2.311 avaliações" },
    { "type": "text", "id": "meta_delivery", "label": "Entrega", "default": "Imediata" }
  ],
  "presets": [
    { "name": "Banner principal" }
  ]
}
{% endschema %}
