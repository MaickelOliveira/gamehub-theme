{%- liquid
  assign platform_tags = ''
  assign genre_tag = ''
  for tag in product.tags
    assign tag_down = tag | downcase
    if tag_down == 'ps4' or tag_down == 'ps5' or tag_down == 'xbox' or tag_down == 'pc'
      assign platform_tags = platform_tags | append: tag_down | append: ','
    elsif tag_down == 'ação' or tag_down == 'corrida' or tag_down == 'guerra' or tag_down == 'esportes' or tag_down == 'rpg' or tag_down == 'terror' or tag_down == 'aventura'
      if genre_tag == ''
        assign genre_tag = tag
      endif
    endif
  endfor
  assign platform_list = platform_tags | split: ','
  assign pix_price = product.price | times: 0.95
-%}

<section class="product-page page-width" {{ section.shopify_attributes }}>
  <div class="product-page__grid">
    <div class="product-page__gallery">
      <div class="product-page__art">
        {%- if product.featured_media -%}
          <img
            id="ProductFeaturedImage"
            class="product-page__art-fill"
            src="{{ product.selected_or_first_available_variant.featured_image | default: product.featured_media | image_url: width: 900 }}"
            alt="{{ product.featured_media.alt | default: product.title | escape }}"
            width="900"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-page__placeholder' }}
        {%- endif -%}

        {%- if product.compare_at_price > product.price -%}
          <span class="product-page__art-badge">-{{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <ul class="product-page__thumbnails">
          {%- for media in product.media -%}
            <li>
              <button type="button" data-thumbnail data-image-url="{{ media | image_url: width: 900 }}" {% if forloop.first %}class="is-active"{% endif %}>
                <img src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | escape }}" width="70" height="70" loading="lazy">
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="product-page__info">
      <span class="product-page__format-badge">Chave digital original</span>
      {%- if genre_tag != blank -%}
        <p class="product-page__genre">{{ genre_tag }}</p>
      {%- endif -%}
      <h1 class="product-page__title">{{ product.title }}</h1>

      <div class="product-page__price-block">
        <div class="product-page__price">
          <span class="product-page__price-current">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <s class="product-card__price-compare">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
        </div>
        <p class="product-page__pix">{{ pix_price | money }} no Pix (5% de desconto)</p>
      </div>

      <p class="product-page__promo">🎮 Leve 2 jogos e ganhe 10% de desconto no combo</p>

      {%- form 'product', product, id: 'ProductForm' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-select>

        <div class="product-page__option-qty-row">
          {%- for option in product.options_with_values -%}
            <div class="product-page__option">
              <label>{{ option.name }}</label>
              <div class="product-page__option-values">
                {%- for value in option.values -%}
                  <button type="button" class="product-page__option-value" data-option-value="{{ value | escape }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <div class="product-page__qty" role="group" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" data-qty-minus aria-label="Diminuir quantidade">&minus;</button>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" data-qty-input>
            <button type="button" data-qty-plus aria-label="Aumentar quantidade">+</button>
          </div>
        </div>

        {%- if platform_list.size > 0 -%}
          <div class="product-page__option" data-platform-group>
            <label>Plataforma</label>
            <div class="product-page__option-values">
              {%- for tag in platform_list -%}
                {%- if tag != blank -%}
                  <button type="button" class="product-page__option-value" data-option-value="{{ tag | upcase }}">{{ tag | upcase }}</button>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <p class="product-page__platform-warning" data-platform-warning hidden>Escolha uma plataforma antes de continuar.</p>
          </div>
        {%- endif -%}

        <div class="product-page__buy-actions">
          <button
            type="submit"
            name="buy_now"
            class="button button--primary product-page__buy-now"
            data-buy-now
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            Comprar agora
          </button>

          <button
            type="submit"
            class="button button--secondary product-page__add-to-cart"
            {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          >
            {%- if product.selected_or_first_available_variant.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <p class="product-page__trust">🔒 Compra segura &middot; ⚡ Entrega imediata por e-mail</p>
      <p class="product-page__payment-methods">Aceita Cartão de crédito &middot; Pix &middot; Boleto</p>
    </div>
  </div>

  <div class="product-page__body">
    <div class="product-page__about">
      <h2 class="product-page__section-title">Sobre o jogo</h2>
      <div class="product-page__description rte">{{ product.description }}</div>
      <ul class="product-page__facts">
        <li><strong>Formato</strong>Chave digital original, entrega por e-mail</li>
        <li><strong>Idioma</strong>Legendas e áudio em português</li>
        <li><strong>Reembolso</strong>Até 7 dias após a compra, se não ativado</li>
      </ul>
    </div>

    <div class="product-page__reviews">
      <h2 class="product-page__section-title">O que os jogadores dizem</h2>
      <div class="reviews-grid">
        <article class="review-card">
          <div class="review-card__head">
            <span class="review-card__avatar">RA</span>
            <div>
              <p class="review-card__name">Rafael Almeida</p>
              <p class="review-card__stars" aria-label="5 de 5 estrelas">★★★★★</p>
            </div>
          </div>
          <p class="review-card__text">"Chave chegou no e-mail em menos de 10 minutos. Ativei na hora e já tava jogando."</p>
        </article>
        <article class="review-card">
          <div class="review-card__head">
            <span class="review-card__avatar">JF</span>
            <div>
              <p class="review-card__name">Juliana Ferreira</p>
              <p class="review-card__stars" aria-label="5 de 5 estrelas">★★★★★</p>
            </div>
          </div>
          <p class="review-card__text">"Já comprei uns 4 jogos aqui, nunca deu problema. Preço bom e suporte responde rápido."</p>
        </article>
        <article class="review-card">
          <div class="review-card__head">
            <span class="review-card__avatar">BC</span>
            <div>
              <p class="review-card__name">Bruno Carvalho</p>
              <p class="review-card__stars" aria-label="5 de 5 estrelas">★★★★★</p>
            </div>
          </div>
          <p class="review-card__text">"Comprei na pré-venda e recebi a chave exatamente no lançamento. Recomendo demais."</p>
        </article>
      </div>
    </div>

    <div class="product-page__faq">
      <h2 class="product-page__section-title">Dúvidas frequentes</h2>
      <details>
        <summary>Como eu recebo o jogo depois de comprar?</summary>
        <p>A chave é enviada automaticamente pro seu e-mail de cadastro, geralmente em poucos minutos após a confirmação do pagamento.</p>
      </details>
      <details>
        <summary>A chave é original?</summary>
        <p>Sim, todas as chaves vendidas na GameHub são originais e ativam direto na plataforma oficial (PSN, Xbox ou Steam/Epic, dependendo do jogo).</p>
      </details>
      <details>
        <summary>Quais formas de pagamento vocês aceitam?</summary>
        <p>Cartão de crédito (em até 12x), Pix (com 5% de desconto) e boleto bancário.</p>
      </details>
      <details>
        <summary>Posso pedir reembolso?</summary>
        <p>Sim, em até 7 dias após a compra, desde que a chave ainda não tenha sido ativada.</p>
      </details>
      <details>
        <summary>Comprei na pré-venda, quando recebo?</summary>
        <p>A chave é liberada automaticamente na data oficial de lançamento do jogo.</p>
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Página do produto",
  "settings": []
}
{% endschema %}
