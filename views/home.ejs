<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="MainContent" role="main">
  <section class="hero" data-hero-slider>
    <% [
      { video: 'Aj1RQW7phc0', start: 5, end: 62, eyebrow: 'Pré-venda em destaque', heading: 'Modern Warfare 4<br>está chegando', text: 'Entre em uma campanha cinematográfica e encare o multiplayer competitivo.<br>Reserve agora para PS5, Xbox ou PC.', primary: 'Reservar · R$ 349,90', primaryUrl: '/products/call-of-duty-modern-warfare-4', secondary: 'Ver pré-vendas', secondaryUrl: '/collections/pre-vendas', platforms: 'PS5 · Xbox · PC', delivery: 'Pré-venda' },
      { video: 'nq1M_Wc4FIc', start: 10, end: 60, eyebrow: 'Jogo em destaque', heading: 'Balance rumo<br>à ação', text: 'Voe por Nova York com Peter Parker e Miles Morales.<br>Marvel’s Spider-Man 2 disponível para PS5 e PC.', primary: 'Comprar · R$ 249,90', primaryUrl: '/products/marvels-spider-man-2', secondary: 'Ver lançamentos', secondaryUrl: '/collections/lancamentos', platforms: 'PS5 · PC', delivery: 'Imediata' },
      { video: 'cv041_93_0Q', start: 4, end: 58, eyebrow: 'Pré-venda aberta', heading: 'Grand Theft Auto VI<br>em Vice City', text: 'Conheça Jason e Lucia na maior evolução da série Grand Theft Auto.<br>Reserve para PS5 ou Xbox Series.', primary: 'Reservar · R$ 399,90', primaryUrl: '/products/grand-theft-auto-vi', secondary: 'Ver pré-vendas', secondaryUrl: '/collections/pre-vendas', platforms: 'PS5 · Xbox', delivery: 'Pré-venda' }
    ].forEach(function(slide, index) { %>
      <div class="hero__slide <%= index === 0 ? 'is-active' : '' %>" data-hero-slide>
        <div class="hero__media"><div class="hero__yt-wrap" data-youtube-hero data-video-id="<%= slide.video %>" data-start="<%= slide.start %>" data-end="<%= slide.end %>" style="background-image:url('https://i.ytimg.com/vi/<%= slide.video %>/maxresdefault.jpg')"><iframe id="youtube-hero-frame-<%= index %>" src="https://www.youtube.com/embed/<%= slide.video %>?autoplay=1&amp;mute=1&amp;controls=0&amp;disablekb=1&amp;fs=0&amp;modestbranding=1&amp;rel=0&amp;playsinline=1&amp;enablejsapi=1&amp;loop=1&amp;playlist=<%= slide.video %>&amp;start=<%= slide.start %>&amp;end=<%= slide.end %>&amp;origin=<%= encodeURIComponent(siteOrigin) %>" title="Vídeo de destaque: <%= slide.eyebrow %>" allow="autoplay; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" <% if (index === 0) { %>loading="eager"<% } else { %>loading="lazy"<% } %>></iframe></div><div class="hero__scrim"></div><div class="hero__fade"></div></div>
        <div class="page-width hero__inner"><div class="hero__content"><span class="hero__eyebrow"><%= slide.eyebrow %></span><h1 class="hero__heading"><%- slide.heading %></h1><p class="hero__subheading"><%- slide.text %></p><div class="hero__actions"><a href="<%= slide.primaryUrl %>" class="button button--primary"><%= slide.primary %></a><a href="<%= slide.secondaryUrl %>" class="button button--secondary"><%= slide.secondary %></a></div><div class="hero__meta"><div><strong><%= slide.platforms %></strong>Disponível em</div><div><strong>Título real</strong>Arte oficial da capa</div><div><strong><%= slide.delivery %></strong>Entrega digital</div></div></div></div>
      </div>
    <% }) %>
    <button type="button" class="hero__nav hero__nav--prev" data-hero-prev aria-label="Banner anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="15 18 9 12 15 6"/></svg></button>
    <button type="button" class="hero__nav hero__nav--next" data-hero-next aria-label="Próximo banner"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><polyline points="9 18 15 12 9 6"/></svg></button>
    <div class="hero__dots" data-hero-dots><% for (let index = 0; index < 3; index += 1) { %><button type="button" class="hero__dot <%= index === 0 ? 'is-active' : '' %>" data-hero-dot="<%= index %>" aria-label="Ir para o banner <%= index + 1 %>"></button><% } %></div>
  </section>

  <section class="carousel-section page-width page-width--wide" data-reveal>
    <div class="carousel-section__header"><div><h2 class="carousel-section__heading">Lançamentos</h2><p class="carousel-section__subheading">Os jogos mais recentes do catálogo</p></div><a href="/collections/lancamentos" class="carousel-section__view-all">Ver todos</a></div>
    <div class="carousel" data-carousel><button type="button" class="carousel__control carousel__control--prev" data-carousel-prev aria-label="Anterior">&larr;</button><ul class="carousel__track" data-carousel-track><% launches.forEach(function(product) { %><li class="carousel__slide"><%- include('partials/product-card', { product }) %></li><% }) %></ul><button type="button" class="carousel__control carousel__control--next" data-carousel-next aria-label="Próximo">&rarr;</button></div>
  </section>

  <section class="carousel-section page-width page-width--wide" data-reveal>
    <div class="carousel-section__header"><div><h2 class="carousel-section__heading">Pré-vendas</h2><p class="carousel-section__subheading">Garanta o seu antes do lançamento oficial</p></div><a href="/collections/pre-vendas" class="carousel-section__view-all">Ver todos</a></div>
    <div class="carousel" data-carousel><button type="button" class="carousel__control carousel__control--prev" data-carousel-prev aria-label="Anterior">&larr;</button><ul class="carousel__track" data-carousel-track><% preorders.forEach(function(product) { %><li class="carousel__slide"><%- include('partials/product-card', { product }) %></li><% }) %></ul><button type="button" class="carousel__control carousel__control--next" data-carousel-next aria-label="Próximo">&rarr;</button></div>
  </section>

  <section class="combo-promo page-width page-width--wide" data-reveal>
    <div class="combo-promo__inner">
      <div class="combo-promo__media">
        <div class="combo-promo__grid" aria-hidden="true"><% comboProducts.slice(0, 6).forEach(function(product) { %><i><img src="<%= product.image_url %>" alt="" loading="lazy"></i><% }) %></div>
        <span class="combo-promo__badge"><strong>6</strong> jogos à sua escolha</span>
      </div>
      <div class="combo-promo__content">
        <span class="combo-promo__eyebrow">Oferta especial · Monte do seu jeito</span>
        <h2 class="combo-promo__heading">Seu combo, suas regras.</h2>
        <p class="combo-promo__text">Misture ação, aventura, corrida e muito mais. Escolha seis jogos diferentes e leve tudo para o carrinho de uma vez.</p>
        <ul class="combo-promo__benefits" aria-label="Vantagens do combo">
          <li>Escolha livre</li><li>PS5 · Xbox · PC</li><li>Adição rápida</li>
        </ul>
        <button type="button" class="button button--primary combo-promo__button" data-combo-builder-open>Escolher meus 6 jogos <span aria-hidden="true">→</span></button>
      </div>
    </div>
  </section>

  <section class="collection-grid-section page-width page-width--wide" data-reveal>
    <div class="carousel-section__header"><div><h2 class="carousel-section__heading">Pronta entrega</h2><p class="carousel-section__subheading">Chave enviada por e-mail após a confirmação do pagamento</p></div><a href="/collections/all" class="carousel-section__view-all">Ver todos</a></div>
    <ul class="product-grid"><% ready.forEach(function(product) { %><li><%- include('partials/product-card', { product }) %></li><% }) %></ul>
  </section>

  <section class="platform-selector page-width page-width--wide">
    <h2 class="carousel-section__heading">Compre por plataforma</h2><p class="carousel-section__subheading">Todo o catálogo, filtrado do jeito que você joga</p>
    <ul class="platform-selector__grid"><% [['PS5','platform-ps5-console.webp','ps5'],['PS4','platform-ps4-console.webp','ps4'],['Xbox','platform-xbox-console.webp','xbox'],['PC','platform-pc-console.webp','pc']].forEach(function(item) { %><li data-reveal-flip><a href="/collections/<%= item[2] %>" class="platform-selector__item"><img class="platform-selector__photo" src="/theme-assets/<%= item[1] %>" alt="Console <%= item[0] %>" loading="lazy"><div class="platform-selector__scrim"></div><span class="platform-selector__count"><%= platformCounts[item[0]] || 0 %> jogos</span><span class="platform-selector__name"><%= item[0] %></span></a></li><% }) %></ul>
  </section>
</main>

<%- include('partials/footer') %>
