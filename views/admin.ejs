<%- include('partials/head') %>
<main class="admin-shell" data-admin-root data-admin-configured="<%= adminConfigured ? 'true' : 'false' %>">
  <section class="admin-login store-panel" data-admin-login>
    <a class="admin-logo" href="/"><span class="site-header__logo-mark"></span><strong><%= settings.store_name %></strong></a>
    <span class="store-kicker">Área restrita</span><h1>Painel administrativo</h1>
    <% if (!adminConfigured) { %><div class="store-form-error">Defina <code>ADMIN_PASSWORD</code> no EasyPanel e faça um novo deploy para liberar o painel.</div><% } %>
    <form data-admin-login-form><label class="store-field">Senha administrativa<input type="password" name="password" required autocomplete="current-password" <%= adminConfigured ? '' : 'disabled' %>></label><div class="store-form-error" data-admin-login-error hidden></div><button class="button button--primary" type="submit" <%= adminConfigured ? '' : 'disabled' %>>Entrar</button></form>
    <a class="admin-back" href="/">← Voltar para a loja</a>
  </section>

  <section class="admin-dashboard" data-admin-dashboard hidden>
    <header class="admin-header"><a class="admin-logo" href="/"><span class="site-header__logo-mark"></span><strong><%= settings.store_name %> Admin</strong></a><nav><button data-admin-tab="overview" class="is-active">Visão geral</button><button data-admin-tab="orders">Pedidos</button><button data-admin-tab="products">Produtos</button><button data-admin-tab="coupons">Cupons</button><button data-admin-tab="settings">Configurações</button></nav><button class="admin-logout" data-admin-logout>Sair</button></header>
    <div class="admin-content">
      <section data-admin-panel="overview"><div class="admin-title"><div><span class="store-kicker">GameHub</span><h1>Visão geral</h1></div><a href="/" target="_blank" class="button button--secondary">Abrir loja</a></div><div class="admin-metrics" data-admin-metrics></div><div class="admin-grid"><div class="store-panel"><h2>Pedidos recentes</h2><div data-admin-recent-orders></div></div><div class="store-panel"><h2>Estoque baixo</h2><div data-admin-low-stock></div></div></div></section>
      <section data-admin-panel="orders" hidden><div class="admin-title"><div><span class="store-kicker">Operação</span><h1>Pedidos</h1></div></div><div class="admin-table-wrap store-panel"><table class="admin-table"><thead><tr><th>Pedido</th><th>Cliente</th><th>Itens</th><th>Total</th><th>Pagamento</th><th>Status</th><th>Data</th></tr></thead><tbody data-admin-orders></tbody></table></div></section>
      <section data-admin-panel="products" hidden><div class="admin-title"><div><span class="store-kicker">Catálogo</span><h1>Produtos</h1></div><button class="button button--primary" data-new-product>Novo produto</button></div><div class="admin-table-wrap store-panel"><table class="admin-table"><thead><tr><th>Produto</th><th>SKU</th><th>Plataformas</th><th>Preço</th><th>Estoque</th><th>Ativo</th><th></th></tr></thead><tbody data-admin-products></tbody></table></div></section>
      <section data-admin-panel="coupons" hidden><div class="admin-title"><div><span class="store-kicker">Promoções</span><h1>Cupons</h1></div></div><div class="admin-grid"><form class="store-panel admin-form" data-coupon-form><h2>Novo cupom</h2><label class="store-field">Código<input name="code" required></label><label class="store-field">Tipo<select name="kind"><option value="percentage">Percentual</option><option value="fixed">Valor fixo</option></select></label><label class="store-field">Valor<input name="value" type="number" min="1" required><small>Percentual inteiro ou valor em centavos.</small></label><label class="store-field">Compra mínima em centavos<input name="minimum_cents" type="number" min="0" value="0"></label><label class="store-field">Expira em<input name="expires_at" type="datetime-local"></label><div class="store-form-error" data-coupon-error hidden></div><button class="button button--primary" type="submit">Salvar cupom</button></form><div class="store-panel"><h2>Cupons cadastrados</h2><div data-admin-coupons></div></div></div></section>
      <section data-admin-panel="settings" hidden><div class="admin-title"><div><span class="store-kicker">Loja</span><h1>Configurações</h1></div></div><form class="store-panel admin-form admin-form--wide" data-settings-form><div class="store-form-grid"><label class="store-field">Nome da loja<input name="store_name" required></label><label class="store-field">E-mail de suporte<input name="support_email" type="email"></label><label class="store-field store-field--wide">Faixa de aviso<input name="announcement"></label><label class="store-field">WhatsApp com DDD<input name="whatsapp" inputmode="tel"></label><label class="store-field">Chave Pix<input name="pix_key"></label><label class="store-field">Desconto no Pix (%)<input name="pix_discount_percent" type="number" min="0" max="30"></label></div><div class="store-form-error" data-settings-error hidden></div><button class="button button--primary" type="submit">Salvar configurações</button></form></section>
    </div>
  </section>

  <dialog class="admin-modal" data-product-modal><form method="dialog" class="store-panel admin-form" data-product-form><div class="admin-modal__head"><h2 data-product-modal-title>Novo produto</h2><button type="button" data-product-close aria-label="Fechar">×</button></div><input type="hidden" name="id"><div class="store-form-grid"><label class="store-field store-field--wide">Nome<input name="name" required></label><label class="store-field">SKU<input name="sku" required></label><label class="store-field">Endereço amigável<input name="slug"></label><label class="store-field">Categoria<select name="category"><option value="pronta-entrega">Pronta entrega</option><option value="lancamentos">Lançamento</option><option value="pre-vendas">Pré-venda</option></select></label><label class="store-field">Plataformas<input name="platforms" placeholder="PS5, Xbox, PC" required></label><label class="store-field">Preço em centavos<input name="price_cents" type="number" min="0" required></label><label class="store-field">Preço anterior em centavos<input name="compare_at_price_cents" type="number" min="0"></label><label class="store-field">Estoque<input name="stock" type="number" min="0" required></label><label class="store-field store-field--wide">Imagem<input type="file" name="image_file" accept="image/jpeg,image/png,image/webp,image/avif"><input name="image_url" placeholder="Ou cole a URL da imagem"></label><label class="store-field store-field--wide">Descrição<textarea name="description" rows="5"></textarea></label><label class="store-checkbox"><input name="featured" type="checkbox"> Produto em destaque</label><label class="store-checkbox"><input name="active" type="checkbox" checked> Produto ativo</label></div><div class="store-form-error" data-product-error hidden></div><button class="button button--primary" type="submit">Salvar produto</button></form></dialog>
  <div class="toast-region" data-toast-region aria-live="polite"></div>
</main>
<script src="/admin.js" defer></script>
</body></html>
