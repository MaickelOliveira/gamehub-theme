<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="MainContent" class="store-main">
  <section class="order-success page-width">
    <div class="order-success__icon">✓</div><span class="store-kicker">Pedido recebido</span><h1><%= order.public_number %></h1><p>Salve este endereço para acompanhar seu pedido.</p>
    <div class="order-success__layout">
      <div class="store-panel"><div class="order-status-line"><span>Status do pedido</span><strong class="store-status store-status--<%= order.status %>"><%= ({awaiting_payment:'Aguardando pagamento',processing:'Em processamento',completed:'Concluído',cancelled:'Cancelado'})[order.status] || order.status %></strong></div><div class="order-status-line"><span>Pagamento</span><strong><%= ({pending:'Pendente',paid:'Pago',refunded:'Reembolsado',cancelled:'Cancelado'})[order.payment_status] || order.payment_status %></strong></div><div class="order-status-line"><span>Total</span><strong class="order-total"><%= formatMoney(order.total_cents) %></strong></div>
        <% if (order.payment_method === 'pix') { %><div class="pix-box"><span>Chave Pix</span><% if (order.pix_key_snapshot) { %><code data-pix-key><%= order.pix_key_snapshot %></code><button type="button" class="button button--primary" data-copy-pix>Copiar chave Pix</button><p>Depois do pagamento, envie o comprovante pelo atendimento para agilizar a liberação.</p><% } else { %><p>A chave Pix ainda não foi configurada. Fale com o atendimento para receber os dados de pagamento.</p><% } %></div><% } %>
        <% if (settings.whatsapp) { %><a class="button button--secondary order-whatsapp" target="_blank" rel="noopener" href="https://wa.me/<%= settings.whatsapp.replace(/\D/g, '') %>?text=<%= encodeURIComponent(`Olá! Quero atendimento sobre o pedido ${order.public_number}.`) %>">Falar no WhatsApp</a><% } %>
      </div>
      <div class="store-panel"><h2>Itens do pedido</h2><ul class="order-items"><% order.items.forEach(function(item) { %><li><div><strong><%= item.name %></strong><span><%= item.platform %> · <%= item.quantity %> unidade<%= item.quantity === 1 ? '' : 's' %></span></div><strong><%= formatMoney(item.subtotal_cents) %></strong></li><% }) %></ul><div class="order-totals"><span>Subtotal <strong><%= formatMoney(order.subtotal_cents) %></strong></span><span>Descontos <strong>− <%= formatMoney(order.discount_cents) %></strong></span><span>Total <strong><%= formatMoney(order.total_cents) %></strong></span></div></div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
