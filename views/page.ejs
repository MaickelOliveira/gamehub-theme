<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="MainContent" role="main">
  <section class="page-content page-width">
    <h1 class="page-content__title"><%= page.title %></h1>
    <div class="page-content__body rte">
      <p class="page-content__intro"><%= page.intro %></p>
      <% page.sections.forEach(function(section) { %><section class="page-content__section"><h2><%= section[0] %></h2><p><%= section[1] %></p></section><% }) %>
      <% if (page.contact) { %><div class="page-content__contact"><a class="button button--primary" href="mailto:<%= settings.support_email %>">Enviar e-mail</a><% if (settings.whatsapp) { %><a class="button button--secondary" href="https://wa.me/<%= settings.whatsapp.replace(/\D/g, '') %>" target="_blank" rel="noopener">Falar no WhatsApp</a><% } %></div><% } %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
