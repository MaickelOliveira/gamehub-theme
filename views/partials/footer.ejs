<footer class="site-footer">
  <div class="page-width site-footer__grid">
    <div class="site-footer__block site-footer__block--brand">
      <div class="site-footer__logo-row">
        <span class="site-header__logo-mark" aria-hidden="true"></span>
        <span class="site-header__logo-text"><%= settings.store_name %></span>
      </div>
      <p class="site-footer__about">Sua loja de jogos digitais, com atendimento especializado e títulos para todas as plataformas.</p>
      <div class="site-footer__pay-badges"><span class="pay-badge pay-badge--pix">Pix</span><span class="pay-badge">Atendimento</span></div>
    </div>
    <div class="site-footer__block">
      <h3>Institucional</h3>
      <ul><li><a href="/pages/sobre">Sobre a GameHub</a></li><li><a href="/pages/trabalhe-conosco">Trabalhe conosco</a></li><li><a href="/policies/terms-of-service">Termos de uso</a></li><li><a href="/policies/privacy-policy">Privacidade</a></li></ul>
    </div>
    <div class="site-footer__block">
      <h3>Ajuda</h3>
      <ul><li><a href="/pages/central-de-ajuda">Central de ajuda</a></li><li><a href="/policies/refund-policy">Trocas e reembolso</a></li><li><a href="/pages/status-do-pedido">Status do pedido</a></li><li><a href="/pages/fale-conosco">Fale conosco</a></li></ul>
    </div>
    <div class="site-footer__block">
      <h3>Receba novidades e ofertas</h3>
      <form class="site-footer__newsletter-form" data-newsletter-form><input type="email" name="email" placeholder="Seu melhor e-mail" required><button type="submit">Cadastrar</button></form><p class="site-footer__newsletter-success" data-newsletter-message hidden></p>
    </div>
  </div>
  <div class="site-footer__bottom page-width"><p>© <%= new Date().getFullYear() %> <%= settings.store_name %>. Todos os direitos reservados.</p><p class="site-footer__payment-note">Compra segura e atendimento especializado.</p></div>
