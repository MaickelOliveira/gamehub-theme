<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="MainContent" role="main">
  <section class="collection-hero">
    <div class="collection-hero__media">
      <% if (collection.video) { %><div class="hero__yt-wrap" data-youtube-hero data-video-id="<%= collection.video[0] %>" data-start="<%= collection.video[1] %>" data-end="<%= collection.video[2] %>" style="background-image:url('https://i.ytimg.com/vi/<%= collection.video[0] %>/maxresdefault.jpg')"><iframe src="https://www.youtube.com/embed/<%= collection.video[0] %>?autoplay=1&amp;mute=1&amp;controls=0&amp;disablekb=1&amp;fs=0&amp;modestbranding=1&amp;rel=0&amp;playsinline=1&amp;enablejsapi=1&amp;loop=1&amp;playlist=<%= collection.video[0] %>&amp;start=<%= collection.video[1] %>&amp;end=<%= collection.video[2] %>&amp;origin=<%= encodeURIComponent(siteOrigin) %>" title="Vídeo da coleção <%= collection.title %>" allow="autoplay; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe></div><% } else { %><div class="collection-hero__image" style="background-image:url('<%= products[0]?.image_url || '/theme-assets/vibe-1.jpg' %>')"></div><% } %>
      <div class="collection-hero__scrim"></div><div class="collection-hero__fade"></div>
    </div>
    <div class="page-width collection-hero__inner"><span class="collection-hero__eyebrow">Categoria</span><h1 class="collection-hero__title"><%= collection.title %></h1><p class="collection-hero__count"><%= products.length %> <%= products.length === 1 ? 'jogo encontrado' : 'jogos encontrados' %></p></div>
  </section>

  <section class="collection-page page-width page-width--wide">
    <div class="collection-page__header"><h2 class="collection-page__title"><%= collection.title %></h2><% if (collection.description) { %><div class="collection-page__description rte"><p><%= collection.description %></p></div><% } %></div>
    <div class="collection-page__toolbar"><p class="collection-page__count"><%= products.length %> produto<%= products.length === 1 ? '' : 's' %></p><form method="get" action="<%= currentPath %>"><% if (filters.query) { %><input type="hidden" name="q" value="<%= filters.query %>"><% } %><% if (filters.category && collection.handle === 'all') { %><input type="hidden" name="category" value="<%= filters.category %>"><% } %><% if (filters.genre && collection.handle === 'all') { %><input type="hidden" name="genre" value="<%= filters.genre %>"><% } %><% if (filters.platform && collection.handle === 'all') { %><input type="hidden" name="platform" value="<%= filters.platform %>"><% } %><label for="SortBy">Ordenar por</label><select name="sort_by" id="SortBy" data-auto-submit><option value="featured" <%= filters.sortBy === 'featured' ? 'selected' : '' %>>Em destaque</option><option value="created-descending" <%= filters.sortBy === 'created-descending' ? 'selected' : '' %>>Mais recentes</option><option value="price-ascending" <%= filters.sortBy === 'price-ascending' ? 'selected' : '' %>>Menor preço</option><option value="price-descending" <%= filters.sortBy === 'price-descending' ? 'selected' : '' %>>Maior preço</option><option value="title-ascending" <%= filters.sortBy === 'title-ascending' ? 'selected' : '' %>>Nome: A–Z</option></select></form></div>
    <% if (products.length) { %><ul class="product-grid"><% products.forEach(function(product) { %><li><%- include('partials/product-card', { product }) %></li><% }) %></ul><% } else { %><p class="carousel-section__empty">Nenhum produto encontrado nesta coleção.</p><div class="store-empty-action"><a class="button button--primary" href="/collections/all">Ver catálogo completo</a></div><% } %>
  </section>
</main>
<%- include('partials/footer') %>
