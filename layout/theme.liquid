<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

  {{ 'base.css' | asset_url | stylesheet_tag }}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --color-background: {{ settings.color_background }};
      --color-surface: {{ settings.color_surface }};
      --color-text: {{ settings.color_text }};
      --color-text-muted: {{ settings.color_text_muted }};
      --color-accent: {{ settings.color_accent }};
      --color-accent-contrast: {{ settings.color_accent_contrast }};
      --color-border: {{ settings.color_border }};
      --font-body: 'Hanken Grotesk', system-ui, sans-serif;
      --font-heading: 'Chakra Petch', system-ui, sans-serif;
      --page-width: {{ settings.page_width }}px;
    }
    {%- if settings.dark_mode_enabled %}
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --color-background: {{ settings.dark_color_background }};
        --color-surface: {{ settings.dark_color_surface }};
        --color-text: {{ settings.dark_color_text }};
        --color-text-muted: {{ settings.dark_color_text_muted }};
        --color-accent: {{ settings.dark_color_accent }};
        --color-accent-contrast: {{ settings.dark_color_accent_contrast }};
        --color-border: {{ settings.dark_color_border }};
      }
    }
    :root[data-theme="dark"] {
      --color-background: {{ settings.dark_color_background }};
      --color-surface: {{ settings.dark_color_surface }};
      --color-text: {{ settings.dark_color_text }};
      --color-text-muted: {{ settings.dark_color_text_muted }};
      --color-accent: {{ settings.dark_color_accent }};
      --color-accent-contrast: {{ settings.dark_color_accent_contrast }};
      --color-border: {{ settings.dark_color_border }};
    }
    {%- endif %}
  </style>

  {%- if settings.dark_mode_enabled %}
    <script>
      (function () {
        try {
          var saved = localStorage.getItem('gamehub_theme');
          document.documentElement.setAttribute('data-theme', (saved === 'light') ? 'light' : 'dark');
        } catch (e) {}
      })();
    </script>
  {%- endif %}

  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  <a class="skip-to-content" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <div id="CartDrawer" class="cart-drawer" hidden>
    <div class="cart-drawer__overlay" data-cart-drawer-close></div>
    <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
      <div class="cart-drawer__header">
        <h2>{{ 'cart.general.title' | t }}</h2>
        <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'accessibility.close' | t }}">&times;</button>
      </div>
      <div id="CartDrawerContent" class="cart-drawer__content"></div>
    </div>
  </div>

  {% render 'combo-builder' %}

  <button type="button" class="sound-toggle" id="SoundToggle" data-muted="true" aria-label="Ativar som do vídeo" hidden>
    <svg class="sound-toggle__muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="4 9 8 9 12 5 12 19 8 15 4 15 4 9"/><line x1="16" y1="9" x2="21" y2="14"/><line x1="21" y1="9" x2="16" y2="14"/></svg>
    <svg class="sound-toggle__unmuted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="4 9 8 9 12 5 12 19 8 15 4 15 4 9"/><path d="M16 8.5a4.5 4.5 0 0 1 0 7"/><path d="M18.5 6a8 8 0 0 1 0 12"/></svg>
  </button>

  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
</body>
</html>
