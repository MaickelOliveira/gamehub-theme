<section class="account-page page-width">
  <h1 class="account-page__title">{{ 'customer.reset_password.title' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}
      <div class="form-errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
    <input type="password" id="ResetPassword" name="customer[password]" required>
    <label for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
    <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" required>
    <button type="submit" class="button button--primary">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</section>
