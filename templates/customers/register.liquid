<section class="account-page page-width">
  <h1 class="account-page__title">{{ 'customer.register.title' | t }}</h1>

  {%- form 'create_customer' -%}
    {%- if form.errors -%}
      <div class="form-errors">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <label for="RegisterFirstName">{{ 'customer.register.first_name' | t }}</label>
    <input type="text" id="RegisterFirstName" name="customer[first_name]" autocomplete="given-name">

    <label for="RegisterLastName">{{ 'customer.register.last_name' | t }}</label>
    <input type="text" id="RegisterLastName" name="customer[last_name]" autocomplete="family-name">

    <label for="RegisterEmail">{{ 'customer.register.email' | t }}</label>
    <input type="email" id="RegisterEmail" name="customer[email]" required autocomplete="email">

    <label for="RegisterPassword">{{ 'customer.register.password' | t }}</label>
    <input type="password" id="RegisterPassword" name="customer[password]" required autocomplete="new-password">

    <button type="submit" class="button button--primary">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</section>
