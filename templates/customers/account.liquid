<section class="account-page page-width">
  <div class="account-page__header">
    <h1 class="account-page__title">{{ 'customer.account.title' | t }}</h1>
    <a href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
  </div>

  <h2>{{ 'customer.orders.title' | t }}</h2>
  {%- if customer.orders.size > 0 -%}
    <table class="account-page__orders">
      <thead>
        <tr>
          <th>{{ 'customer.orders.order_number' | t }}</th>
          <th>{{ 'customer.orders.date' | t }}</th>
          <th>{{ 'customer.orders.payment_status' | t }}</th>
          <th>{{ 'customer.orders.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for order in customer.orders -%}
          <tr>
            <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: '%d/%m/%Y' }}</td>
            <td>{{ order.financial_status_label }}</td>
            <td>{{ order.total_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- else -%}
    <p>{{ 'customer.orders.none' | t }}</p>
  {%- endif -%}

  <h2>{{ 'customer.addresses.title' | t }}</h2>
  <a href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.manage' | t }}</a>
</section>
